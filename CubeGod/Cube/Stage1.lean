import CubeGod.Cube.Small

/-!
# Stage 1: Fact P1

Demaine et al. solve corners, wings, middle edges, + centers and middle centers in `O(n)` moves.
Here we prove a slightly stronger fact, which also
covers X centers, by a compression argument that needs no knowledge of parity.

Take any word `x` solving the state. For a layer `d`, `x` acts on the small cube of `d` as some permutation
`pr d`, and with the moves of layer `d` deleted it acts as a permutation `e`, the same for all `d`.

The pair `(pr d, e)` lies in a fixed finite group `Λ`, generated by the pairs
`(y, y with its inner layers deleted)` for moves `y` of the small cube, whose inner layers are `2` and
`m - 1`. So does `(e, e)`, using a word `t` without inner layers. So `(pr d · e⁻¹, 1)` lies in `Λ`,
and it's the value of a word `v d` of bounded length. On the small cube of `d` the word `v d` acts as
`pr d · e⁻¹`, and on any other small cube it does nothing.

So `t` followed by all the `v d` acts on every small cube as `x` does, in `O(n)` moves.
-/

open Finset

namespace CubeGod

variable {n m d : ℕ}

section Generic

variable {H L : Type*} [Group H]

theorem evalW_mem {K : Subgroup H} {φ : L → H} (hφ : ∀ x, φ x ∈ K) (w : List L) : evalW φ w ∈ K := by
  induction w with
  | nil => exact one_mem _
  | cons x w ih => exact mul_mem ih (hφ x)

theorem evalW_prod {H' : Type*} [Group H'] (f : L → H) (g : L → H') (w : List L) :
    evalW (fun x ↦ (f x, g x)) w = (evalW f w, evalW g w) := by
  induction w with
  | nil => rfl
  | cons x w ih => simp [ih]

/-- In a finite group, the elements generated by letters closed under inverses are words of bounded
length. -/
theorem exists_word_bound [Finite H] (f : L → H) (inv : L → L) (hinv : ∀ x, f (inv x) = (f x)⁻¹) :
    ∃ K : ℕ, ∀ h ∈ Subgroup.closure (Set.range f), ∃ u : List L, u.length ≤ K ∧ evalW f u = h := by
  classical
  have : Fintype H := Fintype.ofFinite H
  have hword : ∀ h ∈ Subgroup.closure (Set.range f), ∃ u : List L, evalW f u = h := by
    intro h hh
    induction hh using Subgroup.closure_induction with
    | mem y hy =>
      obtain ⟨x, rfl⟩ := hy
      exact ⟨[x], by simp⟩
    | one => exact ⟨[], rfl⟩
    | mul y z _ _ hy hz =>
      obtain ⟨u₁, rfl⟩ := hy
      obtain ⟨u₂, rfl⟩ := hz
      exact ⟨u₂ ++ u₁, evalW_append _ _ _⟩
    | inv y _ hy =>
      obtain ⟨u, rfl⟩ := hy
      refine ⟨(u.map inv).reverse, ?_⟩
      clear * - hinv
      induction u with
      | nil => simp
      | cons x u ih =>
        simp only [List.map_cons, List.reverse_cons, evalW_append, evalW_cons, evalW_nil, one_mul,
          ih, hinv]
        simp
  have hex : ∀ h : H, ∃ u : List L, h ∈ Subgroup.closure (Set.range f) → evalW f u = h := by
    intro h
    by_cases hh : h ∈ Subgroup.closure (Set.range f)
    · obtain ⟨u, hu⟩ := hword h hh
      exact ⟨u, fun _ ↦ hu⟩
    · exact ⟨[], fun h' ↦ absurd h' hh⟩
  choose F hF using hex
  exact ⟨(Finset.univ : Finset H).sup fun h ↦ (F h).length, fun h hh ↦
    ⟨F h, Finset.le_sup (f := fun h ↦ (F h).length) (Finset.mem_univ h), hF h hh⟩⟩

end Generic

/-- A move of the small cube, and what it does with its inner layers `2` and `m - 1` deleted. -/
def pairLetter (x : Move m) : Equiv.Perm (Sticker m) × Equiv.Perm (Sticker m) :=
  (x.perm, dropOne x)

theorem pairLetter_inv (x : Move m) : pairLetter x.inv = (pairLetter x)⁻¹ := by
  simp [pairLetter, Move.perm_inv, dropOne_inv]

/-- The value of `down` at a lifted move of the same layer. -/
theorem down_lift_same (hm : 0 < (m + 1) / 2) (hS : SmallFor n m) (hd : InI n d) (y : Move m) :
    down hm d (liftMove hd y) = y.perm := by
  unfold down
  have : unlift n m d (liftMove hd y).layer = some y.layer :=
    unlift_liftIdx hS hd y.layer_pos y.layer_le
  rw [this]
  exact congrArg Move.perm (smallMove_eq hm y.layer_pos y.layer_le _ y rfl rfl rfl)

/-- Lifts of a move of a layer other than the inner layers `2` and `m - 1` don't depend on `d`. -/
theorem liftMove_indep (hS : SmallFor n m) {d' : ℕ} (hd : InI n d) (hd' : InI n d') (y : Move m)
    (hy : ¬ (y.layer = 2 ∨ y.layer = m - 1)) : liftMove hd y = liftMove hd' y := by
  have := y.layer_pos
  have := y.layer_le
  apply Move.ext
  · rfl
  · simp only [liftMove, liftIdx]
    rcases hS with ⟨rfl, -⟩ | ⟨rfl, -⟩ <;> split_ifs <;> omega
  · rfl

/-- The value of `down` at a lifted move of a different layer. -/
theorem down_lift_other (hm : 0 < (m + 1) / 2) (hS : SmallFor n m)
    {d' : ℕ} (hd : InI n d) (hd' : InI n d') (hne : d' ≠ d) (y : Move m) :
    down hm d' (liftMove hd y) = dropOne y := by
  by_cases hy : y.layer = 2 ∨ y.layer = m - 1
  · have a₁ := hd.1; have a₂ := hd.2; have a₃ := hd'.1; have a₄ := hd'.2
    have : unlift n m d' (liftMove hd y).layer = none := by
      simp only [liftMove, liftIdx, unlift, unliftFlat]
      rcases hS with ⟨rfl, hp⟩ | ⟨rfl, hp⟩ <;> rcases hy with hy | hy <;> simp [hy] <;>
        split_ifs <;> first | rfl | omega
    simp [down, this, dropOne, hy]
  · rw [liftMove_indep hS hd hd' y hy, down_lift_same hm hS hd' y]
    simp [dropOne, hy]

theorem two_mem_I (hn : 4 ≤ n) : InI n 2 := ⟨le_rfl, by omega⟩

/-- `unliftFlat` only finds layers of the small cube other than its inner layers `2` and `m - 1`. -/
theorem unliftFlat_ne (hS : SmallFor n m) {l k : ℕ} (h : unliftFlat n m l = some k) :
    ¬ (k = 2 ∨ k = m - 1) := by
  unfold unliftFlat at h
  rcases hS with ⟨rfl, -⟩ | ⟨rfl, -⟩ <;> split_ifs at h <;> simp only [Option.some.injEq] at h <;>
    omega

theorem unliftFlat_bounds (hS : SmallFor n m) {l k : ℕ} (h : unliftFlat n m l = some k) :
    1 ≤ k ∧ k ≤ m := by
  unfold unliftFlat at h
  rcases hS with ⟨rfl, -⟩ | ⟨rfl, -⟩ <;> split_ifs at h <;> simp only [Option.some.injEq] at h <;>
    omega

/-- A word of the big cube gives an element of the group of pairs. -/
theorem down_flat_mem (hm : 0 < (m + 1) / 2) (hS : SmallFor n m) (hd : InI n d) (w : List (Move n)) :
    (evalW (down hm d) w, evalW (flat hm) w) ∈
      Subgroup.closure (Set.range (pairLetter (m := m))) := by
  rw [← evalW_prod]
  refine evalW_mem (fun x ↦ ?_) w
  have a₁ := hd.1
  have a₂ := hd.2
  have hm' : 2 ≤ m - 1 ∧ m - 1 ≤ m := by rcases hS with ⟨rfl, -⟩ | ⟨rfl, -⟩ <;> norm_num
  have hflat : ∀ l, (l = d ∨ l = n + 1 - d) → unliftFlat n m l = none := by
    intro l hl
    unfold unliftFlat
    rcases hS with ⟨rfl, hp⟩ | ⟨rfl, hp⟩ <;> split_ifs <;> first | rfl | omega
  unfold down flat unlift
  by_cases h₁ : x.layer = d
  · rw [ite_eq_left h₁, hflat _ (Or.inl h₁)]
    refine Subgroup.subset_closure ⟨smallMove hm 2 x, ?_⟩
    simp [pairLetter, dropOne, layer_smallMove (k := 2) hm (by norm_num) (by omega)]
  · rw [ite_eq_right h₁]
    by_cases h₂ : x.layer = n + 1 - d
    · rw [ite_eq_left h₂, hflat _ (Or.inr h₂)]
      refine Subgroup.subset_closure ⟨smallMove hm (m - 1) x, ?_⟩
      simp [pairLetter, dropOne, layer_smallMove hm (by omega) hm'.2]
    · rw [ite_eq_right h₂]
      split
      · rename_i k hk
        refine Subgroup.subset_closure ⟨smallMove hm k x, ?_⟩
        have := unliftFlat_ne hS hk
        have hb := unliftFlat_bounds hS hk
        simp [pairLetter, dropOne, layer_smallMove hm hb.1 hb.2, this]
      · exact one_mem _

theorem flat_mem (hm : 0 < (m + 1) / 2) (hS : SmallFor n m) (w : List (Move n)) :
    evalW (flat hm) w ∈ Subgroup.closure (Set.range (dropOne (m := m))) := by
  refine evalW_mem (fun x ↦ ?_) w
  unfold flat
  split
  · rename_i k hk
    refine Subgroup.subset_closure ⟨smallMove hm k x, ?_⟩
    have := unliftFlat_ne hS hk
    have hb := unliftFlat_bounds hS hk
    simp [dropOne, layer_smallMove hm hb.1 hb.2, this]
  · exact one_mem _

/-- Each column or row of a Stage 1 sticker is a column of the small cube of its layer of `I`:
column or row `c` is in layer `c + 1` from one side. -/
theorem exists_small_idx (hS : SmallFor n m) (hn : 4 ≤ n) {p : Sticker n} (hp : Stage1 p) :
    ∃ d, InI n d ∧ ∀ c : ℕ, (c = p.2.1 ∨ c = p.2.2) →
      ∃ k, 1 ≤ k ∧ k ≤ m ∧ liftIdx n m d k = c + 1 := by
  obtain ⟨ρ, hρ⟩ := hp.one_layer
  set d := if InI n ρ then ρ else 2 with hdef
  have hdI : InI n d := by
    rw [hdef]
    split_ifs with h
    · exact h
    · exact two_mem_I hn
  refine ⟨d, hdI, fun c hc ↦ ?_⟩
  -- The sticker is in layer `c + 1` and `n - c` from the faces at the ends of its row or column.
  have hc₁ : HasLayer (c + 1) p := by
    rcases hc with rfl | rfl
    · refine ⟨p.1.right.opp, ?_⟩
      rw [layerFrom_opp, layerFrom_right]
      have := p.2.1.2
      omega
    · refine ⟨p.1.up.opp, ?_⟩
      rw [layerFrom_opp, layerFrom_up]
      have := p.2.2.2
      omega
  have hc₂ : HasLayer (n - c) p := by
    rcases hc with rfl | rfl
    · exact ⟨p.1.right, layerFrom_right p⟩
    · exact ⟨p.1.up, layerFrom_up p⟩
  have hcn : c < n := by rcases hc with rfl | rfl <;> exact Fin.is_lt _
  have a₁ := hdI.1
  have a₂ := hdI.2
  -- A layer of `I` that holds the sticker is `ρ`, so it's `d`.
  have hI : ∀ e, InI n e → HasLayer e p → e = d := by
    intro e he hpe
    by_contra hne
    by_cases heρ : e = ρ
    · subst heρ
      rw [hdef, ite_eq_left he] at hne
      exact hne rfl
    · exact hρ e he heρ hpe
  by_cases h0 : c = 0
  · exact ⟨1, le_rfl, by rcases hS with ⟨rfl, -⟩ | ⟨rfl, -⟩ <;> norm_num, by simp [liftIdx, h0]⟩
  by_cases h1 : c = n - 1
  · refine ⟨m, by rcases hS with ⟨rfl, -⟩ | ⟨rfl, -⟩ <;> norm_num, le_rfl, ?_⟩
    simp only [liftIdx]
    rcases hS with ⟨rfl, -⟩ | ⟨rfl, -⟩ <;> simp <;> omega
  by_cases hmid : 2 * c + 1 = n
  · refine ⟨3, by norm_num, ?_, ?_⟩
    · rcases hS with ⟨rfl, hp⟩ | ⟨rfl, -⟩ <;> omega
    · simp only [liftIdx]
      rcases hS with ⟨rfl, hp⟩ | ⟨rfl, -⟩ <;> simp <;> omega
  by_cases hlo : 2 * c + 1 < n
  · have := hI (c + 1) ⟨by omega, by omega⟩ hc₁
    refine ⟨2, by norm_num, by rcases hS with ⟨rfl, -⟩ | ⟨rfl, -⟩ <;> norm_num, ?_⟩
    simp [liftIdx, this]
  · have := hI (n - c) ⟨by omega, by omega⟩ hc₂
    refine ⟨m - 1, by rcases hS with ⟨rfl, -⟩ | ⟨rfl, -⟩ <;> norm_num,
      by rcases hS with ⟨rfl, -⟩ | ⟨rfl, -⟩ <;> norm_num, ?_⟩
    simp only [liftIdx]
    rcases hS with ⟨rfl, -⟩ | ⟨rfl, -⟩ <;> simp <;> omega

/-- Every Stage 1 sticker is in the small cube of some layer. -/
theorem exists_small (hS : SmallFor n m) (hn : 4 ≤ n) {p : Sticker n} (hp : Stage1 p) :
    ∃ (d : ℕ) (hd : InI n d) (v : Sticker m), p = liftS hd v := by
  obtain ⟨d, hd, h⟩ := exists_small_idx hS hn hp
  obtain ⟨i, hi₁, hi₂, ei⟩ := h _ (Or.inl rfl)
  obtain ⟨j, hj₁, hj₂, ej⟩ := h _ (Or.inr rfl)
  refine ⟨d, hd, (p.1, ⟨i - 1, by omega⟩, ⟨j - 1, by omega⟩), Prod.ext rfl (Prod.ext ?_ ?_)⟩
  · apply Fin.ext
    simp only [liftS, Nat.sub_add_cancel hi₁, ei]
    omega
  · apply Fin.ext
    simp only [liftS, Nat.sub_add_cancel hj₁, ej]
    omega

/-- A move of the small cube is one of the layers that the other small cubes see too. -/
def Kept (y : Move m) : Prop := ¬ (y.layer = 2 ∨ y.layer = m - 1)

instance (y : Move m) : Decidable (Kept y) := by unfold Kept; infer_instance

theorem evalW_filter_kept (u : List (Move m)) :
    evalW (fun y ↦ y.perm) (u.filter fun y ↦ decide (Kept y)) = evalW dropOne u := by
  induction u with
  | nil => rfl
  | cons y u ih =>
    by_cases hy : Kept y
    · rw [List.filter_cons, ite_eq_left (by simpa using hy), evalW_cons, ih]
      simp [dropOne, show ¬ (y.layer = 2 ∨ y.layer = m - 1) from hy]
    · rw [List.filter_cons, ite_eq_right (by simpa using hy), ih]
      simp only [evalW_cons, dropOne]
      rw [ite_eq_left (not_not.mp hy), mul_one]

theorem evalW_dropOne_of_kept {t : List (Move m)} (ht : ∀ y ∈ t, Kept y) :
    evalW dropOne t = evalW (fun y ↦ y.perm) t := by
  induction t with
  | nil => rfl
  | cons y l ih =>
    have hy := ht y (by simp)
    simp only [evalW_cons, dropOne, ite_eq_right hy]
    rw [ih fun z hz ↦ ht z (by simp [hz])]

theorem evalW_down_lift_of_kept (hm : 0 < (m + 1) / 2) (hS : SmallFor n m)
    (hone : InI n 2) (hd : InI n d) {t : List (Move m)} (ht : ∀ y ∈ t, Kept y) :
    evalW (down hm d) (t.map (liftMove hone)) = evalW (fun y ↦ y.perm) t := by
  rw [evalW_map]
  induction t with
  | nil => rfl
  | cons y l ih =>
    simp only [evalW_cons]
    have hy := ht y (by simp)
    have hval : (down hm d ∘ liftMove hone) y = y.perm := by
      simp only [Function.comp]
      rw [liftMove_indep hS hone hd y hy, down_lift_same hm hS hd y]
    rw [hval, ih fun z hz ↦ ht z (by simp [hz])]

/-- The word for the small cube of `d`, lifted, or nothing if `d` isn't a layer of `I`. -/
def liftWord (d : ℕ) (v : List (Move m)) : List (Move n) :=
  if hd : InI n d then v.map (liftMove hd) else []

/-- Fact P1, for cubes with the same small cube. -/
theorem factP1_small (hm : 0 < (m + 1) / 2) : ∃ K : ℕ, ∀ n, SmallFor n m → 4 ≤ n →
    ∀ s : State n, Solvable s → ∃ w : List (Move n), w.length ≤ K * n ∧
      ∀ p, Stage1 p → (act w s).get p = (solved n).get p := by
  classical
  obtain ⟨K₀, hK₀⟩ := exists_word_bound (pairLetter (m := m)) Move.inv pairLetter_inv
  obtain ⟨K₁, hK₁⟩ := exists_word_bound (dropOne (m := m)) Move.inv dropOne_inv
  refine ⟨K₁ + K₀, fun n hS h4 s hs ↦ ?_⟩
  have hone := two_mem_I h4
  obtain ⟨x, hx⟩ := hs
  set e₀ := evalW (flat (n := n) hm) x with he₀
  -- A word `t` without the inner layers `2` and `m - 1` that acts as `e₀`.
  obtain ⟨u, hu₁, hu₂⟩ := hK₁ e₀ (flat_mem hm hS x)
  set t := u.filter fun y ↦ decide (Kept y) with ht
  have htA : evalW (fun y : Move m ↦ y.perm) t = e₀ := by rw [ht, evalW_filter_kept, hu₂]
  have htlen : t.length ≤ K₁ := (List.length_filter_le _ _).trans hu₁
  have htmem : ∀ y ∈ t, Kept y := fun y hy ↦ by
    simpa using (List.mem_filter.mp hy).2
  have htdrop : evalW dropOne t = e₀ := by
    rw [← htA, evalW_dropOne_of_kept htmem]
  -- For each layer, a bounded word doing the rest.
  have hΛt : (e₀, e₀) ∈ Subgroup.closure (Set.range (pairLetter (m := m))) := by
    have := evalW_mem (K := Subgroup.closure (Set.range (pairLetter (m := m))))
      (φ := pairLetter) (fun y ↦ Subgroup.subset_closure ⟨y, rfl⟩) t
    have he : evalW pairLetter t = (evalW (fun y : Move m ↦ y.perm) t, evalW dropOne t) :=
      evalW_prod _ _ _
    rwa [he, htA, htdrop] at this
  have hword : ∀ d, ∃ v : List (Move m), InI n d → v.length ≤ K₀ ∧
      evalW (fun y ↦ y.perm) v = evalW (down hm d) x * e₀⁻¹ ∧ evalW dropOne v = 1 := by
    intro d
    by_cases hd : InI n d
    · have hμ := mul_mem (down_flat_mem hm hS hd x) (inv_mem hΛt)
      obtain ⟨v, hv₁, hv₂⟩ := hK₀ _ hμ
      have he : evalW pairLetter v = (evalW (fun y : Move m ↦ y.perm) v, evalW dropOne v) :=
        evalW_prod _ _ _
      rw [he] at hv₂
      have h₁ := congrArg Prod.fst hv₂
      have h₂ := congrArg Prod.snd hv₂
      simp only [Prod.fst_mul, Prod.snd_mul, Prod.fst_inv, Prod.snd_inv, ← he₀, mul_inv_cancel] at h₁ h₂
      exact ⟨v, fun _ ↦ ⟨hv₁, h₁, h₂⟩⟩
    · exact ⟨[], fun h ↦ absurd h hd⟩
  choose v hv using hword
  set layers : List ℕ := (Finset.Icc 2 (n / 2)).toList with hlayers
  have hlnd : layers.Nodup := Finset.nodup_toList _
  have hmem : ∀ d, d ∈ layers ↔ InI n d := by
    intro d
    simp only [hlayers, Finset.mem_toList, Finset.mem_Icc, InI]
    omega
  set w : List (Move n) := t.map (liftMove hone) ++
    layers.flatMap fun d ↦ liftWord (n := n) d (v d) with hw
  refine ⟨w, ?_, ?_⟩
  · -- The length.
    have hlen₂ : (layers.flatMap fun d ↦ liftWord (n := n) d (v d)).length ≤ layers.length * K₀ := by
      have : ∀ (l : List ℕ), (∀ d ∈ l, InI n d) →
          (l.flatMap fun d ↦ liftWord (n := n) d (v d)).length ≤ l.length * K₀ := by
        intro l hl
        induction l with
        | nil => simp
        | cons d l ih =>
          simp only [List.flatMap_cons, List.length_append, List.length_cons]
          have hd := hl d (by simp)
          have h₁ := (hv d hd).1
          have h₂ := ih fun d' hd' ↦ hl d' (by simp [hd'])
          rw [liftWord, dite_eq_left hd, List.length_map]
          rw [Nat.add_mul, one_mul]
          omega
      exact this _ fun d hd ↦ (hmem d).mp hd
    have hlen₃ : layers.length ≤ n := by
      rw [hlayers, Finset.length_toList, Nat.card_Icc]
      omega
    rw [hw, List.length_append, List.length_map]
    have : layers.length * K₀ ≤ n * K₀ := Nat.mul_le_mul_right _ hlen₃
    nlinarith
  · intro p hp
    obtain ⟨d, hd, y, rfl⟩ := exists_small hS h4 hp
    -- `w` acts on the small cube of `d` as `x` does.
    have heval : evalW (down hm d) w = evalW (down hm d) x := by
      have hA : evalW (down hm d) (t.map (liftMove hone)) = e₀ := by
        rw [← htA]
        exact evalW_down_lift_of_kept hm hS hone hd htmem
      have hB : evalW (down hm d) (layers.flatMap fun d ↦ liftWord (n := n) d (v d)) =
          evalW (down hm d) x * e₀⁻¹ := by
        rw [evalW_flatMap_single hlnd ((hmem d).mpr hd)]
        · rw [liftWord, dite_eq_left hd, evalW_map, ← (hv d hd).2.1]
          refine congrArg (fun φ ↦ evalW φ (v d)) (funext fun y ↦ ?_)
          exact down_lift_same hm hS hd y
        · intro d' hd' hne
          have hd'I := (hmem d').mp hd'
          rw [liftWord, dite_eq_left hd'I, evalW_map, ← (hv d' hd'I).2.2]
          refine congrArg (fun φ ↦ evalW φ (v d')) (funext fun y ↦ ?_)
          exact down_lift_other hm hS hd'I hd (Ne.symm hne) y
      rw [hw, evalW_append, hA, hB]
      simp
    rw [act_liftS_eq hm hS hd heval, hx]

/-- **Fact P1**, in a stronger form: the corners, wings, middle edges, + centers, middle centers and X
centers of a solvable state can be solved in `O(n)` moves. -/
theorem factP1 : ∃ K : ℕ, ∀ (n : ℕ) (s : State n), Solvable s → ∃ w : List (Move n),
    w.length ≤ K * n ∧ ∀ p, Stage1 p → (act w s).get p = (solved n).get p := by
  obtain ⟨K₄, h₄⟩ := factP1_small (m := 4) (by norm_num)
  obtain ⟨K₅, h₅⟩ := factP1_small (m := 5) (by norm_num)
  set K₀ := (Finset.range 4).sup godsNumber with hK₀
  refine ⟨K₄ + K₅ + K₀, fun n s hs ↦ ?_⟩
  by_cases h : 4 ≤ n
  · by_cases hp : n % 2 = 0
    · obtain ⟨w, hw₁, hw₂⟩ := h₄ n (Or.inl ⟨rfl, hp⟩) h s hs
      exact ⟨w, hw₁.trans (Nat.mul_le_mul_right _ (by omega)), hw₂⟩
    · obtain ⟨w, hw₁, hw₂⟩ := h₅ n (Or.inr ⟨rfl, by omega⟩) h s hs
      exact ⟨w, hw₁.trans (Nat.mul_le_mul_right _ (by omega)), hw₂⟩
  · -- Small cubes: all solvable states have bounded distance.
    by_cases h0 : n = 0
    · subst h0
      exact ⟨[], by simp, fun p _ ↦ p.2.1.elim0⟩
    · obtain ⟨w, hw₁, hw₂⟩ := exists_word_le hs
      refine ⟨w, ?_, fun p _ ↦ by rw [hw₁]⟩
      have h₁ : godsNumber n ≤ K₀ := Finset.le_sup (f := godsNumber) (Finset.mem_range.mpr (by omega))
      have h₂ : K₀ ≤ (K₄ + K₅ + K₀) * n := by nlinarith [Nat.pos_of_ne_zero h0]
      omega

end CubeGod
