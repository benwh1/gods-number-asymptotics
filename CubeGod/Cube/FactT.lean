section Search

variable {Ω : Type*} [DecidableEq Ω]

/-- One step of the search. -/
def bfsStep (gs : List (Equiv.Perm Ω)) (S : Finset Ω) : Finset Ω :=
  S ∪ S.biUnion fun x ↦ (gs.map fun t ↦ t x).toFinset ∪ (gs.map fun t ↦ t⁻¹ x).toFinset

/-- The points found from `x₀` in `k` steps. -/
def bfs (gs : List (Equiv.Perm Ω)) (x₀ : Ω) : ℕ → Finset Ω
  | 0 => {x₀}
  | k + 1 => bfsStep gs (bfs gs x₀ k)

/-- The search only finds points that the group really reaches. -/
theorem bfs_sound {gs : List (Equiv.Perm Ω)} {x₀ z : Ω} {k : ℕ} (hz : z ∈ bfs gs x₀ k) :
    ∃ t ∈ Subgroup.closure {t | t ∈ gs}, t x₀ = z := by
  induction k generalizing z with
  | zero =>
    rw [bfs, Finset.mem_singleton] at hz
    exact ⟨1, one_mem _, by simp [hz]⟩
  | succ k ih =>
    rw [bfs, bfsStep, Finset.mem_union, Finset.mem_biUnion] at hz
    rcases hz with hz | ⟨x, hx, hz⟩
    · exact ih hz
    · obtain ⟨s, hs, rfl⟩ := ih hx
      rw [Finset.mem_union, List.mem_toFinset, List.mem_toFinset, List.mem_map, List.mem_map] at hz
      rcases hz with ⟨t, ht, rfl⟩ | ⟨t, ht, rfl⟩
      · exact ⟨t * s, mul_mem (Subgroup.subset_closure ht) hs, rfl⟩
      · exact ⟨t⁻¹ * s, mul_mem (inv_mem (Subgroup.subset_closure ht)) hs, rfl⟩

end Search

section Orbit

variable (p : Pos → Prop) [DecidablePred p]

/-- The permutations of an orbit that lie in `G₀`. -/
def orbitPerms (G₀ : Subgroup (Equiv.Perm Pos)) : Subgroup (Equiv.Perm (Subtype p)) :=
  G₀.comap (ofSubtype : _ →* _)

variable {p} {G₀ : Subgroup (Equiv.Perm Pos)}

/-- A group generated by permutations in `G₀` that stay on the orbit comes from permutations of the
orbit. -/
theorem lift_closure {gs : List (Equiv.Perm Pos)} (hmem : ∀ t ∈ gs, t ∈ G₀)
    (hpres : ∀ t ∈ gs, ∀ u, p (t u) ↔ p u) (hsupp : ∀ t ∈ gs, ∀ u, t u ≠ u → p u)
    {t : Equiv.Perm Pos} (ht : t ∈ Subgroup.closure {t | t ∈ gs}) :
    ∃ t' ∈ orbitPerms p G₀, ofSubtype t' = t := by
  induction ht using Subgroup.closure_induction with
  | mem x hx =>
    refine ⟨x.subtypePerm (hpres x hx), ?_, ofSubtype_subtypePerm _ (hsupp x hx)⟩
    change ofSubtype _ ∈ G₀
    rw [ofSubtype_subtypePerm _ (hsupp x hx)]
    exact hmem x hx
  | one => exact ⟨1, one_mem _, map_one _⟩
  | mul x y _ _ hx hy =>
    obtain ⟨x', hx', rfl⟩ := hx
    obtain ⟨y', hy', rfl⟩ := hy
    exact ⟨x' * y', mul_mem hx' hy', map_mul _ _ _⟩
  | inv x _ hx =>
    obtain ⟨x', hx', rfl⟩ := hx
    exact ⟨x'⁻¹, inv_mem hx', map_inv _ _⟩

/-- Elements generated by permutations fixing `x` fix `x`. -/
theorem closure_fix {gs : List (Equiv.Perm Pos)} {x : Pos} {t : Equiv.Perm Pos}
    (ht : t ∈ Subgroup.closure {t | t ∈ gs.filter fun t ↦ t x = x}) :
    t ∈ Subgroup.closure {t | t ∈ gs} ∧ t x = x := by
  induction ht using Subgroup.closure_induction with
  | mem y hy =>
    have := List.mem_filter.mp hy
    exact ⟨Subgroup.subset_closure this.1, by simpa using this.2⟩
  | one => exact ⟨one_mem _, rfl⟩
  | mul y z _ _ hy hz =>
    exact ⟨mul_mem hy.1 hz.1, by simp [hz.2, hy.2]⟩
  | inv y _ hy =>
    refine ⟨inv_mem hy.1, ?_⟩
    rw [Equiv.Perm.inv_eq_iff_eq]
    exact hy.2.symm

/-- If the group is 2-transitive and contains a 3-cycle, it contains the alternating group. -/
theorem alternating_le {gs : List (Equiv.Perm Pos)} (hmem : ∀ t ∈ gs, t ∈ G₀)
    (hpres : ∀ t ∈ gs, ∀ u, p (t u) ↔ p u) (hsupp : ∀ t ∈ gs, ∀ u, t u ≠ u → p u)
    (p₀ p₁ : Subtype p)
    (cover₁ : ∀ u : Subtype p, u.1 ∈ bfs gs p₀.1 2)
    (cover₂ : ∀ u : Subtype p, u ≠ p₀ → u.1 ∈ bfs (gs.filter fun t ↦ t p₀.1 = p₀.1) p₁.1 2)
    {t₀ : Equiv.Perm Pos} (ht₀ : t₀ ∈ gs) (h3 : t₀.IsThreeCycle) :
    alternatingGroup (Subtype p) ≤ orbitPerms p G₀ := by
  -- From the base pair to any pair.
  have hbase : ∀ x y : Subtype p, x ≠ y → ∃ g ∈ orbitPerms p G₀, g p₀ = x ∧ g p₁ = y := by
    intro x y hxy
    obtain ⟨t, ht, htx⟩ := bfs_sound (cover₁ x)
    obtain ⟨a, ha, rfl⟩ := lift_closure hmem hpres hsupp ht
    have hax : a p₀ = x := Subtype.ext (by simpa [ofSubtype_apply_coe] using htx)
    have hy' : a⁻¹ y ≠ p₀ := by
      intro h
      apply hxy
      rw [← hax, ← h]
      simp
    obtain ⟨s, hs, hsy⟩ := bfs_sound (cover₂ _ hy')
    obtain ⟨hs₁, hs₂⟩ := closure_fix hs
    obtain ⟨b, hb, rfl⟩ := lift_closure hmem hpres hsupp hs₁
    have hb₀ : b p₀ = p₀ := Subtype.ext (by simpa [ofSubtype_apply_coe] using hs₂)
    have hb₁ : b p₁ = a⁻¹ y := Subtype.ext (by simpa [ofSubtype_apply_coe] using hsy)
    exact ⟨a * b, mul_mem ha hb, by simp [hb₀, hax], by simp [hb₁]⟩
  have htwo : IsMultiplyPretransitive (orbitPerms p G₀) (Subtype p) 2 := by
    rw [isMultiplyPretransitive_iff]
    intro x y
    have hx : x 0 ≠ x 1 := fun h ↦ by simpa using x.injective h
    have hy : y 0 ≠ y 1 := fun h ↦ by simpa using y.injective h
    obtain ⟨a, ha, ha₀, ha₁⟩ := hbase _ _ hx
    obtain ⟨b, hb, hb₀, hb₁⟩ := hbase _ _ hy
    refine ⟨⟨b * a⁻¹, mul_mem hb (inv_mem ha)⟩, Function.Embedding.ext fun i ↦ ?_⟩
    fin_cases i
    · change (b * a⁻¹) (x 0) = y 0
      rw [Equiv.Perm.mul_apply, ← ha₀]
      simp [hb₀]
    · change (b * a⁻¹) (x 1) = y 1
      rw [Equiv.Perm.mul_apply, ← ha₁]
      simp [hb₁]
  have hprim : IsPreprimitive (orbitPerms p G₀) (Subtype p) :=
    isPreprimitive_of_is_two_pretransitive htwo
  obtain ⟨t₀', h₁, h₂⟩ := lift_closure hmem hpres hsupp (Subgroup.subset_closure ht₀)
  have h3' : t₀'.IsThreeCycle := by
    unfold IsThreeCycle at h3 ⊢
    rw [← cycleType_ofSubtype, h₂]
    exact h3
  exact alternatingGroup_le_of_isPreprimitive_of_isThreeCycle_mem hprim h3' h₁

end Orbit

/-- Two functions with 4 points over each face differ by an even permutation. -/
theorem Balanced.exists_even {Ω : Type*} [Fintype Ω] [DecidableEq Ω] {f g : Ω → Face}
    (hf : Balanced f) (hg : Balanced g) : ∃ τ ∈ alternatingGroup Ω, f ∘ τ = g := by
  obtain ⟨τ, hτ⟩ := hf.exists_perm hg
  by_cases hs : sign τ = 1
  · exact ⟨τ, mem_alternatingGroup.mpr hs, hτ⟩
  · -- Swap two stickers of the same face to fix the parity.
    have hcard : 1 < Fintype.card {a // f a = .U} := by
      rw [hf .U]; norm_num
    obtain ⟨⟨a, ha⟩, ⟨b, hb⟩, hab⟩ := Fintype.exists_pair_of_one_lt_card hcard
    have hne : a ≠ b := fun h ↦ hab (Subtype.ext h)
    refine ⟨swap a b * τ, ?_, ?_⟩
    · rw [mem_alternatingGroup, map_mul, sign_swap hne]
      rcases Int.units_eq_one_or (sign τ) with h | h
      · exact absurd h hs
      · simp [h]
    · funext x
      have : f (swap a b (τ x)) = f (τ x) := by
        by_cases h₁ : τ x = a
        · simp [h₁, ha, hb]
        · by_cases h₂ : τ x = b
          · simp [h₂, ha, hb]
          · rw [swap_apply_of_ne_of_ne h₁ h₂]
      simpa using this.trans (congrFun hτ x)

theorem pure_R : ∀ g ∈ cyclesR, g.Pure true := by decide +kernel

theorem pure_L : ∀ g ∈ cyclesL, g.Pure false := by decide +kernel

/-- A base point on the right-handed positions. -/
def baseR₀ : SPos true := ⟨⟨(.U, .L, .F), by decide⟩, by decide⟩
/-- A second base point on the right-handed positions. -/
def baseR₁ : SPos true := ⟨⟨(.U, .F, .R), by decide⟩, by decide⟩

/-- A base point on the left-handed positions. -/
def baseL₀ : SPos false := ⟨⟨(.U, .L, .B), by decide⟩, by decide⟩
/-- A second base point on the left-handed positions. -/
def baseL₁ : SPos false := ⟨⟨(.U, .F, .L), by decide⟩, by decide⟩

theorem cover_R₁ : ∀ u : SPos true, u.1 ∈ bfs (cyclesR.map (Cycle.perm · 1)) baseR₀.1 2 := by
  decide +kernel

theorem cover_R₂ : ∀ u : SPos true, u ≠ baseR₀ →
    u.1 ∈ bfs ((cyclesR.map (Cycle.perm · 1)).filter fun t ↦ t baseR₀.1 = baseR₀.1) baseR₁.1 2 := by
  decide +kernel

theorem cover_L₁ : ∀ u : SPos false, u.1 ∈ bfs (cyclesL.map (Cycle.perm · 1)) baseL₀.1 2 := by
  decide +kernel

theorem cover_L₂ : ∀ u : SPos false, u ≠ baseL₀ →
    u.1 ∈ bfs ((cyclesL.map (Cycle.perm · 1)).filter fun t ↦ t baseL₀.1 = baseL₀.1) baseL₁.1 2 := by
  decide +kernel

theorem three_R : (Cycle.perm ⟨⟨.U, true⟩, ⟨.L, true⟩, ⟨.L, true⟩⟩ 1).IsThreeCycle := by
  have : Cycle.perm ⟨⟨.U, true⟩, ⟨.L, true⟩, ⟨.L, true⟩⟩ 1 =
      swap (⟨(.U, .L, .F), by decide⟩ : Pos) ⟨(.B, .D, .L), by decide⟩ *
        swap (⟨(.U, .L, .F), by decide⟩ : Pos) ⟨(.B, .L, .U), by decide⟩ := by
    decide +kernel
  rw [this]
  exact isThreeCycle_swap_mul_swap_same (by decide) (by decide) (by decide)

theorem three_L : (Cycle.perm ⟨⟨.U, true⟩, ⟨.R, true⟩, ⟨.L, true⟩⟩ 1).IsThreeCycle := by
  have : Cycle.perm ⟨⟨.U, true⟩, ⟨.R, true⟩, ⟨.L, true⟩⟩ 1 =
      swap (⟨(.U, .L, .B), by decide⟩ : Pos) ⟨(.F, .U, .R), by decide⟩ *
        swap (⟨(.U, .L, .B), by decide⟩ : Pos) ⟨(.B, .L, .D), by decide⟩ := by
    decide +kernel
  rw [this]
  exact isThreeCycle_swap_mul_swap_same (by decide) (by decide) (by decide)

/-- The facts that `alternating_le` needs of a list of pure 3-cycles. -/
theorem alternating_of_pure {q : Bool} {l : List Cycle} (hl : ∀ g ∈ l, g.Pure q) (p₀ p₁ : SPos q)
    (cover₁ : ∀ u : SPos q, u.1 ∈ bfs (l.map (Cycle.perm · 1)) p₀.1 2)
    (cover₂ : ∀ u : SPos q, u ≠ p₀ →
      u.1 ∈ bfs ((l.map (Cycle.perm · 1)).filter fun t ↦ t p₀.1 = p₀.1) p₁.1 2)
    {g₀ : Cycle} (hg₀ : g₀ ∈ l) (h3 : (g₀.perm 1).IsThreeCycle) :
    alternatingGroup (SPos q) ≤ orbitPerms (OnSide q) (tcGroup q) := by
  refine alternating_le (gs := l.map (Cycle.perm · 1)) ?_ ?_ ?_ p₀ p₁ cover₁ cover₂
    (List.mem_map.mpr ⟨g₀, hg₀, rfl⟩) h3
  · intro t ht
    obtain ⟨g, hg, rfl⟩ := List.mem_map.mp ht
    exact Subgroup.subset_closure ⟨⟨g, hl g hg⟩, rfl⟩
  · intro t ht
    obtain ⟨g, -, rfl⟩ := List.mem_map.mp ht
    exact onSide_iff (g.perm_mem 1) q
  · intro t ht u hu
    obtain ⟨g, hg, rfl⟩ := List.mem_map.mp ht
    by_contra h
    exact hu (hl g hg u h)

set_option maxRecDepth 100000 in
/-- On each orbit, its 3-cycles generate every even permutation. -/
theorem alternating_side : ∀ q, alternatingGroup (SPos q) ≤ orbitPerms (OnSide q) (tcGroup q)
  | true => alternating_of_pure pure_R baseR₀ baseR₁ cover_R₁ cover_R₂ List.mem_cons_self three_R
  | false => alternating_of_pure pure_L baseL₀ baseL₁ cover_L₁ cover_L₂ List.mem_cons_self three_L

/-- What the 3-cycles do on the positions, they also do on an orbit's patterns. -/
theorem sideAct_mem {q : Bool} {σ : Equiv.Perm Pos} (hσ : σ ∈ tcGroup q) :
    ∃ h : σ ∈ orbitGroup, sideAct q ⟨σ, h⟩ ∈
      Subgroup.closure (Set.range (Function.uncurry (sideCyc q))) := by
  induction hσ using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨g, rfl⟩ := hx
    exact ⟨g.1.perm_mem 1, Subgroup.subset_closure ⟨(g, 1), rfl⟩⟩
  | one =>
    refine ⟨one_mem _, ?_⟩
    have : sideAct q ⟨1, one_mem _⟩ = 1 := map_one (sideAct q)
    rw [this]
    exact one_mem _
  | mul x y _ _ hx hy =>
    obtain ⟨h₁, h₂⟩ := hx
    obtain ⟨h₃, h₄⟩ := hy
    refine ⟨mul_mem h₁ h₃, ?_⟩
    have : sideAct q ⟨x * y, mul_mem h₁ h₃⟩ = sideAct q ⟨x, h₁⟩ * sideAct q ⟨y, h₃⟩ := by
      rw [← map_mul]
      rfl
    rw [this]
    exact mul_mem h₂ h₄
  | inv x _ hx =>
    obtain ⟨h₁, h₂⟩ := hx
    refine ⟨inv_mem h₁, ?_⟩
    have : sideAct q ⟨x⁻¹, inv_mem h₁⟩ = (sideAct q ⟨x, h₁⟩)⁻¹ := by
      rw [← map_inv]
      rfl
    rw [this]
    exact inv_mem h₂

/-- **Fact T:** on each orbit, the 3-cycles act transitively on patterns. -/
theorem factT (q : Bool) (x y : OState q) :
    ∃ w ∈ Subgroup.closure (Set.range (Function.uncurry (sideCyc q))), w x = y := by
  obtain ⟨τ, hτ, hxy⟩ := Balanced.exists_even x.2 y.2
  have hext : ofSubtype τ ∈ tcGroup q := alternating_side q hτ
  obtain ⟨h, hw⟩ := sideAct_mem (inv_mem hext)
  refine ⟨_, hw, Subtype.ext ?_⟩
  rw [sideAct_val]
  funext u
  have : ((restr q ⟨(ofSubtype τ)⁻¹, h⟩)⁻¹ u) = τ u := by
    apply Subtype.ext
    change (ofSubtype τ)⁻¹⁻¹ u.1 = (τ u).1
    rw [inv_inv, ofSubtype_apply_coe]
  simp only [Function.comp_apply, this]
  exact congrFun hxy u

/-- The cycle system of one orbit. -/
def cubeSys (q : Bool) : CycleSystem (OState q) (Fin 2) (SideCycle q) where
  e := sideCyc q
  e_zero := sideCyc_zero q
  solved := sSolved q
  trans := factT q

end CubeGod
