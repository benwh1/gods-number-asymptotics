import CubeGod.Cube.Cycles
import CubeGod.Schedule.Basic

/-!
# Fact T: the 3-cycles act transitively on each orbit's patterns

The 3-cycles `[[a, b], c]` are pure: each moves three positions of one orbit and nothing else.
`scripts/find_cycles.py` picks a short list of them for each orbit, from which Lean's kernel checks,
by a breadth-first search, that the group they generate is 2-transitive on that orbit. Jordan's theorem
in Mathlib then gives the whole alternating group on the orbit.

A pattern has 4 stickers of each face, so any two patterns of an orbit differ by an even
permutation: swapping two equal stickers fixes the parity.
-/

open Finset Equiv Equiv.Perm MulAction

namespace CubeGod

/-- The group generated by the 3-cycles of one orbit. -/
def tcGroup (q : Bool) : Subgroup (Equiv.Perm Pos) :=
  Subgroup.closure (Set.range fun g : SideCycle q ↦ g.1.perm 1)

