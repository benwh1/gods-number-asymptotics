import CubeGod.Cube.FactT
import CubeGod.Method.Walk

/-!
# Pure 3-cycles on the real cube, and Fact P2 for oblique orbits

The 3-cycle `[[a, b], c]` of a pair `(e, d)` moves one orbit of the pair, and it leaves every other
sticker of the cube where it was: a sticker that isn't in the pair lacks one of the two layers, so
on that sticker `a` or `c` does nothing, and the commutator collapses.

So any element of the group generated by these 3-cycles is done by moves that change only the pair.
That group is finite, so one bound `K` on the length of the word works for all `n`, `d₁` and `d₂`.
-/

open Finset Equiv Equiv.Perm

namespace CubeGod

variable {n d₁ d₂ : ℕ}

/-- `p` is in layer `d` from some face. -/
def HasLayer (d : ℕ) (p : Sticker n) : Prop := ∃ G : Face, layerFrom G p = d

/-- Moves keep the layers a sticker is in. -/
theorem hasLayer_perm {d : ℕ} (m : Move n) (p : Sticker n) :
    HasLayer d (m.perm p) ↔ HasLayer d p := by
  by_cases h : layerFrom m.face p = m.layer
  · constructor
    · rintro ⟨G, hG⟩
      refine ⟨m.face.turnBy m.dir.reverse G, ?_⟩
      rw [← Move.layerFrom_perm h]
      have := m.face.turnBy_reverse m.dir.reverse G
      rw [Direction.reverse_reverse] at this
      rw [this, hG]
    · rintro ⟨G, hG⟩
      exact ⟨m.face.turnBy m.dir G, by rw [Move.layerFrom_perm h, hG]⟩
  · rw [Move.perm_of_ne h]

/-- Layer `d` from a face is layer `n + 1 - d` from the opposite face. -/
theorem hasLayer_flip {d : ℕ} {p : Sticker n} (hd : d < n) (h : HasLayer (n + 1 - d) p) :
    HasLayer d p := by
  obtain ⟨G, hG⟩ := h
  refine ⟨G.opp, ?_⟩
  have := layerFrom_pos G p
  rw [layerFrom_opp, hG]
  omega

/-- Moves of layer `d` or `n + 1 - d` leave alone every sticker not in layer `d`. -/
theorem perm_eq_self {m : Move n} {p : Sticker n} {d : ℕ} (hd : d < n)
    (hl : m.layer = d ∨ m.layer = n + 1 - d) (hp : ¬ HasLayer d p) : m.perm p = p := by
  refine Move.perm_of_ne fun h ↦ hp ?_
  rcases hl with hl | hl
  · exact ⟨m.face, by rw [h, hl]⟩
  · exact hasLayer_flip hd ⟨m.face, by rw [h, hl]⟩

/-- A sticker in both layers of a pair is one of the pair's stickers. -/
theorem mem_pair (h₁ : InI n d₁) (h₂ : InI n d₂) (hne : d₁ ≠ d₂) (p : Sticker n)
    (hr₁ : HasLayer d₁ p) (hr₂ : HasLayer d₂ p) : ∃ u, p = embed h₁ h₂ u := by
  obtain ⟨G₁, e₁⟩ := hr₁
  obtain ⟨G₂, e₂⟩ := hr₂
  have a₁ := h₁.1
  have a₂ := h₁.2
  have b₁ := h₂.1
  have b₂ := h₂.2
  have hself := layerFrom_self p
  have hopp := layerFrom_opp p.1 p
  rw [hself] at hopp
  -- A face whose layer `d` holds `p` isn't on the axis of `p`'s face.
  have hax : ∀ (G : Face) (d : ℕ), layerFrom G p = d → 2 ≤ d → 2 * d ≤ n → G.axis ≠ p.1.axis := by
    intro G d hG h₁ h₂ hax
    rcases (Face.axis_eq_iff G p.1).mp hax with e | e <;> rw [e] at hG <;> omega
  have a₁₃ := hax G₁ d₁ e₁ a₁ a₂
  have a₂₃ := hax G₂ d₂ e₂ b₁ b₂
  have a₁₂ : G₁.axis ≠ G₂.axis := by
    intro hax'
    rcases (Face.axis_eq_iff G₂ G₁).mp hax'.symm with e | e
    · rw [e] at e₂; omega
    · rw [e, layerFrom_opp, e₁] at e₂; omega
  exact ⟨⟨(G₁, G₂, p.1), a₁₂, a₁₃, a₂₃⟩, eq_embed h₁ h₂ _ rfl e₁ e₂⟩

/-- The sticker at a position of a pair belongs on its outer face. -/
theorem solved_embed (h₁ : InI n d₁) (h₂ : InI n d₂) (u : Pos) :
    (solved n).get (embed h₁ h₂ u) = u.dir .outer := rfl

/-- A list of moves staying on a set of stickers can be evaluated by anything agreeing with them there. -/
theorem permW_eq_of_fix {H : Set (Sticker n)} {w : List (Move n)} {φ : Move n → Equiv.Perm (Sticker n)}
    (hK : ∀ m ∈ w, ∀ p ∈ H, m.perm p ∈ H) (hφ : ∀ m ∈ w, ∀ p ∈ H, φ m p = m.perm p) :
    ∀ p ∈ H, permW w p = evalW φ w p := by
  induction w with
  | nil => intro p _; rfl
  | cons m w ih =>
    intro p hp
    have h₁ := hK m (by simp) p hp
    have h₂ := hφ m (by simp) p hp
    have := ih (fun m' hm' ↦ hK m' (by simp [hm'])) (fun m' hm' ↦ hφ m' (by simp [hm'])) _ h₁
    simp only [permW, evalW_cons, Equiv.Perm.mul_apply] at this ⊢
    rw [this, h₂]

/-- The 3-cycle `[[a, b], c] = [[a, b] : c] c'` of the pair `(e, d)`, as moves. -/
def Cycle.moves (hn : 0 < (n + 1) / 2) (g : Cycle) (e d : ℕ) : List (Move n) :=
  (g.conj hn [e] [d]).moves ++ [(g.c.at hn d).inv]

theorem Cycle.length_moves (hn : 0 < (n + 1) / 2) (g : Cycle) (e d : ℕ) :
    (g.moves hn e d).length = 10 := by
  simp [Cycle.moves, CommConj.moves, CommConj.setup, Cycle.conj]

theorem Cycle.evalW_moves {H : Type*} [Group H] {φ : Move n → H} (hφ : ∀ m, φ m.inv = (φ m)⁻¹)
    (hn : 0 < (n + 1) / 2) (g : Cycle) (e d : ℕ) :
    evalW φ (g.moves hn e d) = (φ (g.c.at hn d))⁻¹ *
      (((φ (g.b.at hn 1))⁻¹ * (φ (g.a.at hn e))⁻¹ * φ (g.b.at hn 1) * φ (g.a.at hn e))⁻¹ *
        φ (g.c.at hn d) *
        ((φ (g.b.at hn 1))⁻¹ * (φ (g.a.at hn e))⁻¹ * φ (g.b.at hn 1) * φ (g.a.at hn e))) := by
  rw [Cycle.moves, evalW_append, CommConj.evalW_moves hφ, CommConj.evalW_setup hφ]
  simp [Cycle.conj, hφ]

/-- The moves are the 3-cycle on the pair. -/
theorem pairW_cycle (hn : 0 < (n + 1) / 2) (h₁ : InI n d₁) (h₂ : InI n d₂) (hne : d₁ ≠ d₂)
    (g : Cycle) : pairW d₁ d₂ (g.moves hn d₁ d₂) = g.perm 1 := by
  have ha : letterOf d₁ d₂ (g.a.at hn d₁) = g.a.on .one := letterOf_mv_one hn h₁ _ _
  have hc : letterOf d₁ d₂ (g.c.at hn d₂) = g.c.on .two :=
    letterOf_mv_two hn h₁ h₂ (Ne.symm hne) _ _
  have hb : letterOf d₁ d₂ (g.b.at hn 1) = g.b.on .outer := letterOf_mv_outer hn h₁ h₂ _ _
  rw [pairW, Cycle.evalW_moves (letterOf_inv d₁ d₂), ha, hb, hc]
  simp only [Cycle.perm, Cycle.setP, Cycle.setup, Cycle.fire, ↓reduceIte]
  group

/-- The 3-cycle is nothing where `a` or `c` does nothing. -/
theorem Cycle.evalW_moves_eq_one {H : Type*} [Group H] {φ : Move n → H}
    (hφ : ∀ m, φ m.inv = (φ m)⁻¹) (hn : 0 < (n + 1) / 2) (g : Cycle) (e d : ℕ)
    (h : φ (g.a.at hn e) = 1 ∨ φ (g.c.at hn d) = 1) : evalW φ (g.moves hn e d) = 1 := by
  rw [Cycle.evalW_moves hφ]
  rcases h with h | h <;> simp only [h, inv_one, one_mul, mul_one] <;> group

/-- The moves of one layer, from either side, don't count on stickers not in that layer. -/
def dropLayer (d : ℕ) (m : Move n) : Equiv.Perm (Sticker n) :=
  if m.layer = d ∨ m.layer = n + 1 - d then 1 else m.perm

theorem dropLayer_inv (d : ℕ) (m : Move n) : dropLayer d m.inv = (dropLayer d m)⁻¹ := by
  have hl : m.inv.layer = m.layer := rfl
  unfold dropLayer
  rw [hl]
  split_ifs
  · rw [inv_one]
  · rw [Move.perm_inv]

theorem permW_eq_dropLayer (hd : d₁ < n) (w : List (Move n)) (p : Sticker n)
    (hp : ¬ HasLayer d₁ p) : permW w p = evalW (dropLayer d₁) w p := by
  refine permW_eq_of_fix (H := {p | ¬ HasLayer d₁ p}) ?_ ?_ p hp
  · intro m _ q hq
    exact fun h ↦ hq ((hasLayer_perm m q).mp h)
  · intro m _ q hq
    unfold dropLayer
    split_ifs with hl
    · exact (perm_eq_self hd hl hq).symm
    · rfl

/-- The 3-cycle leaves every other sticker of the cube alone. -/
theorem permW_cycle (hn : 0 < (n + 1) / 2) (h₁ : InI n d₁) (h₂ : InI n d₂) (hne : d₁ ≠ d₂)
    (g : Cycle) {p : Sticker n} (hp : ∀ u, p ≠ embed h₁ h₂ u) :
    permW (g.moves hn d₁ d₂) p = p := by
  have hdrop : ∀ {d : ℕ} (hd : InI n d) (t : Turn), dropLayer d (t.at hn d) = 1 := fun hd t ↦ by
    unfold dropLayer Turn.at
    rw [ite_eq_left (Or.inl (layer_mv_I hn hd _ _))]
  by_cases R₁ : HasLayer d₁ p
  · by_cases R₂ : HasLayer d₂ p
    · obtain ⟨u, hu⟩ := mem_pair h₁ h₂ hne p R₁ R₂
      exact absurd hu (hp u)
    · rw [permW_eq_dropLayer h₂.lt_n _ _ R₂,
        Cycle.evalW_moves_eq_one (dropLayer_inv d₂) hn g _ _ (Or.inr (hdrop h₂ _))]
      rfl
  · rw [permW_eq_dropLayer h₁.lt_n _ _ R₁,
      Cycle.evalW_moves_eq_one (dropLayer_inv d₁) hn g _ _ (Or.inl (hdrop h₁ _))]
    rfl

/-- What a list of 3-cycles does to the positions. -/
def cyclesPerm (l : List Cycle) : Equiv.Perm Pos := evalW (fun g : Cycle ↦ g.perm 1) l

/-- A list of 3-cycles of the pair `(d₁, d₂)`, as moves. -/
def cyclesWord (hn : 0 < (n + 1) / 2) (d₁ d₂ : ℕ) (l : List Cycle) : List (Move n) :=
  l.flatMap fun g ↦ g.moves hn d₁ d₂

theorem length_cyclesWord (hn : 0 < (n + 1) / 2) (d₁ d₂ : ℕ) (l : List Cycle) :
    (cyclesWord hn d₁ d₂ l).length = 10 * l.length := by
  induction l with
  | nil => rfl
  | cons g l ih =>
    simp only [cyclesWord, List.flatMap_cons, List.length_append, List.length_cons,
      Cycle.length_moves] at ih ⊢
    omega

theorem pairW_cyclesWord (hn : 0 < (n + 1) / 2) (h₁ : InI n d₁) (h₂ : InI n d₂) (hne : d₁ ≠ d₂)
    (l : List Cycle) : pairW d₁ d₂ (cyclesWord hn d₁ d₂ l) = cyclesPerm l := by
  induction l with
  | nil => rfl
  | cons g l ih =>
    simp only [cyclesWord, List.flatMap_cons, cyclesPerm, evalW_cons] at ih ⊢
    rw [pairW, evalW_append, ← pairW, ← pairW, ih, pairW_cycle hn h₁ h₂ hne]

/-- A list of 3-cycles changes no sticker outside the pair. -/
theorem permW_cyclesWord (hn : 0 < (n + 1) / 2) (h₁ : InI n d₁) (h₂ : InI n d₂) (hne : d₁ ≠ d₂)
    (l : List Cycle) {p : Sticker n} (hp : ∀ u, p ≠ embed h₁ h₂ u) :
    permW (cyclesWord hn d₁ d₂ l) p = p := by
  induction l with
  | nil => rfl
  | cons g l ih =>
    simp only [cyclesWord, List.flatMap_cons] at ih ⊢
    rw [permW, evalW_append, Equiv.Perm.mul_apply, ← permW, permW_cycle hn h₁ h₂ hne g hp]
    exact ih

/-- The group is finite, so every element is a product of the 3-cycles themselves, and one length
is enough for all of them. -/
theorem exists_cycles_bound :
    ∃ K : ℕ, ∀ σ ∈ tcGroup true, ∃ l : List Cycle, l.length ≤ K ∧ cyclesPerm l = σ := by
  classical
  have hex : ∀ σ ∈ tcGroup true, ∃ l : List Cycle, cyclesPerm l = σ := by
    intro σ hσ
    have : σ ∈ Submonoid.closure (Set.range fun g : SideCycle true ↦ g.1.perm 1) := by
      rw [← Subgroup.closure_toSubmonoid_of_finite]
      exact hσ
    clear hσ
    induction this using Submonoid.closure_induction with
    | mem x hx =>
      obtain ⟨g, rfl⟩ := hx
      exact ⟨[g.1], by simp [cyclesPerm]⟩
    | one => exact ⟨[], rfl⟩
    | mul x y _ _ hx hy =>
      obtain ⟨l₁, rfl⟩ := hx
      obtain ⟨l₂, rfl⟩ := hy
      exact ⟨l₂ ++ l₁, by simp [cyclesPerm, evalW_append]⟩
  have hex' : ∀ σ : Equiv.Perm Pos, ∃ l : List Cycle, σ ∈ tcGroup true → cyclesPerm l = σ := by
    intro σ
    by_cases h : σ ∈ tcGroup true
    · obtain ⟨l, hl⟩ := hex σ h
      exact ⟨l, fun _ ↦ hl⟩
    · exact ⟨[], fun h' ↦ absurd h' h⟩
  choose f hf using hex'
  refine ⟨(Finset.univ : Finset (Equiv.Perm Pos)).sup fun σ ↦ (f σ).length, fun σ hσ ↦ ?_⟩
  exact ⟨f σ, Finset.le_sup (f := fun σ ↦ (f σ).length) (Finset.mem_univ σ), hf σ hσ⟩

/-- **Fact P2, for oblique orbits.** There is a `K` such that for all `n`, an oblique orbit with 4
stickers of each face can be solved in at most `K` moves, changing no other sticker. -/
theorem factP2_oblique : ∃ K : ℕ, ∀ (n d₁ d₂ : ℕ) (h₁ : InI n d₁) (h₂ : InI n d₂), d₁ ≠ d₂ →
    ∀ s : State n, Balanced (fun u : PosR ↦ s.get (embed h₁ h₂ u.1)) →
    ∃ w : List (Move n), w.length ≤ K ∧
      (∀ u : PosR, (act w s).get (embed h₁ h₂ u.1) = u.1.dir .outer) ∧
      ∀ p : Sticker n, (∀ u : PosR, p ≠ embed h₁ h₂ u.1) → (act w s).get p = s.get p := by
  obtain ⟨K₀, hK₀⟩ := exists_cycles_bound
  refine ⟨10 * K₀, fun n d₁ d₂ h₁ h₂ hne s hs ↦ ?_⟩
  have hn : 0 < (n + 1) / 2 := h₁.pos'
  obtain ⟨τ, hτ, hfτ⟩ := Balanced.exists_even (Ω := SPos true) hs (solved_balanced true)
  have hext : ofSubtype τ ∈ tcGroup true := alternating_side true hτ
  obtain ⟨l, hl, hperm⟩ := hK₀ _ (inv_mem hext)
  set w := cyclesWord hn d₁ d₂ l with hw
  have hpair : pairW d₁ d₂ w = (ofSubtype τ)⁻¹ := by
    rw [hw, pairW_cyclesWord hn h₁ h₂ hne, hperm]
  have hview : ∀ u, (act w s).get (embed h₁ h₂ u) = s.get (embed h₁ h₂ (ofSubtype τ u)) := by
    intro u
    have := congrFun (pairView_act h₁ h₂ hne w s) u
    simp only [pairView, Function.comp, hpair] at this
    rw [this]
    rfl
  refine ⟨w, ?_, ?_, ?_⟩
  · rw [hw, length_cyclesWord]
    omega
  · intro u
    rw [hview, show ofSubtype τ u.1 = (τ u).1 from ofSubtype_apply_coe τ u]
    exact congrFun hfτ u
  · intro p hp
    by_cases hpp : ∃ u, p = embed h₁ h₂ u
    · -- `p` is on the other orbit of the pair, which the permutation leaves alone.
      obtain ⟨u, rfl⟩ := hpp
      have hu : ¬ u.Proper := fun h ↦ hp ⟨u, h⟩ rfl
      rw [hview, ofSubtype_apply_of_not_mem τ hu]
    · -- `p` isn't in the pair.
      push Not at hpp
      rw [act_eq]
      have hfix : (permW w) p = p := permW_cyclesWord hn h₁ h₂ hne l hpp
      have : (permW w).symm p = p := by
        conv_lhs => rw [← hfix]
        simp
      simp [this]

end CubeGod
